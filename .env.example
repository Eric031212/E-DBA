# Copy to .env and adjust. Every setting is EDBA_<NAME>; see src/edba/config.py.
EDBA_ENV=dev
EDBA_DATABASE_URL=sqlite:///./edba.db
# postgres: EDBA_DATABASE_URL=postgresql+psycopg://edba:edba@localhost:5432/edba
EDBA_SECRET_KEY=change-me-to-a-long-random-string-of-32+-chars
# Optional dedicated Fernet key for secrets at rest (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
EDBA_DATA_KEY=
EDBA_UPLOAD_DIR=./var/uploads
EDBA_T_ADMIN_EMAIL=tadmin@edba.example
# inbox = store mail in the DB and read it at /dev/mailbox; smtp = really send
EDBA_MAIL_BACKEND=inbox
EDBA_SMTP_HOST=localhost
EDBA_SMTP_PORT=587
EDBA_SMTP_USER=
EDBA_SMTP_PASSWORD=
# Demo campus + bank gateway mounted at /gateway
EDBA_MOUNT_DEMO_GATEWAY=true
EDBA_BANK_GATEWAY_URL=http://127.0.0.1:8000/gateway
# Comma separated hosts organizations may point connectors at (empty = any)
EDBA_CONNECTOR_ALLOWED_HOSTS=
